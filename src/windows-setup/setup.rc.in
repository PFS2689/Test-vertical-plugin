#include <windows.h>
#include "setup_resources.h"

1 VERSIONINFO
 FILEVERSION PAYLOAD_VER_MAJOR,PAYLOAD_VER_MINOR,PAYLOAD_VER_PATCH,0
 PRODUCTVERSION PAYLOAD_VER_MAJOR,PAYLOAD_VER_MINOR,PAYLOAD_VER_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Vertical Shorts Plugin Contributors"
            VALUE "FileDescription", "Professional Vertical Streaming Plugin for OBS Studio"
            VALUE "FileVersion", "PAYLOAD_VER_STRING"
            VALUE "InternalName", "Vertical-Shorts-Plugin-Setup"
            VALUE "LegalCopyright", "Copyright (C) Vertical Shorts Plugin Contributors"
            VALUE "OriginalFilename", "Vertical-Shorts-Plugin-PAYLOAD_VER_STRING-Setup.exe"
            VALUE "ProductName", "Vertical Shorts Plugin"
            VALUE "ProductVersion", "PAYLOAD_VER_STRING"
            VALUE "Comments", "Open-source per-user OBS plugin installer. Source: https://github.com/PFS2689/verticalshorts"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDR_PLUGIN_DLL RCDATA "PAYLOAD_DLL_PATH"
IDR_LOCALE_INI RCDATA "PAYLOAD_LOCALE_PATH"
IDR_INSTALL_TXT RCDATA "PAYLOAD_INSTALL_TXT_PATH"

1 24 "PAYLOAD_MANIFEST_PATH"
